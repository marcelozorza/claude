{"versao":"04/10 19:42 · 1641c3d","duracao":65.3,"fps":30,"aceleracao":1.1,"faixas":[{"id":"fala","nome":"Fala","itens":[{"ini":0.0,"fim":3.24,"rotulo":"De manhã, você escova os dentes, passa o café e pega o celular."},{"ini":3.62,"fim":5.76,"rotulo":"Tudo isso sem pensar em nenhum desses passos."},{"ini":5.96,"fim":9.24,"rotulo":"Existe uma explicação no cérebro para isso, e ela cabe em uma frase."},{"ini":9.46,"fim":13.84,"rotulo":"Em 1949, psicólogo canadense Donald Hebb propôs uma ideia simples."},{"ini":14.28,"fim":17.82,"rotulo":"Quando um neurônio ajuda a disparar outro muitas vezes, a ligação entre os dois"},{"ini":17.82,"fim":18.64,"rotulo":"fica mais forte."},{"ini":18.84,"fim":19.76,"rotulo":"Pense em dois neurônios."},{"ini":19.8,"fim":22.34,"rotulo":"O primeiro dispara e o segundo dispara logo depois."},{"ini":22.64,"fim":24.46,"rotulo":"Na primeira vez, o sinal passa fraco."},{"ini":24.58,"fim":26.8,"rotulo":"Na décima, passa com mais facilidade."},{"ini":27.02,"fim":29.44,"rotulo":"Na centésima, um quase arrasta o outro."},{"ini":29.44,"fim":31.32,"rotulo":"A ponte entre eles engrossou."},{"ini":31.5,"fim":33.0,"rotulo":"É assim que um hábito se forma."},{"ini":33.24,"fim":37.08,"rotulo":"A mesma sequência repetida no mesmo lugar a mesma hora vira um caminho pronto."},{"ini":37.22,"fim":38.36,"rotulo":"E quanto tempo isso leva?"},{"ini":38.52,"fim":40.74,"rotulo":"Talvez você já tenha ouvido falar em 21 dias."},{"ini":41.06,"fim":45.26,"rotulo":"Esse número vem de um livro de 1960, escrito por um cirurgião plástico a partir do"},{"ini":45.26,"fim":46.68,"rotulo":"que ele via nos pacientes."},{"ini":46.88,"fim":51.92,"rotulo":"Em 2010, pesquisadoras de Londres acompanharam 96 pessoas tentando criar um hábito novo."},{"ini":52.08,"fim":54.2,"rotulo":"Na mediana, foram 66 dias."},{"ini":54.54,"fim":58.38,"rotulo":"Teve gente que chegou lá em 18, teve gente que demorou 254."},{"ini":58.38,"fim":62.26,"rotulo":"Então, se tá difícil, faz sentido. Seu cérebro ainda está construindo a ligação."},{"ini":62.58,"fim":64.26,"rotulo":"E cada repetição engrossa a ponte."}]},{"id":"titulos","nome":"Títulos","itens":[{"ini":11.92,"fim":32.17,"rotulo":"“Neurônios que disparam juntos ficam ligados”","fica":false},{"ini":39.05,"fim":47.28,"rotulo":"21 dias","fica":false},{"ini":47.59,"fim":51.12,"rotulo":"Londres: 96 pessoas","fica":false},{"ini":52.19,"fim":54.8,"rotulo":"66 dias","fica":false},{"ini":59.65,"fim":65.3,"rotulo":"Cérebro em construção","fica":true}]},{"id":"fotos","nome":"Fotos","itens":[{"ini":0.0,"fim":2.1,"rotulo":"escova de dentes","fica":false},{"ini":1.83,"fim":3.73,"rotulo":"café","fica":false},{"ini":2.53,"fim":5.33,"rotulo":"celular","fica":false},{"ini":5.2,"fim":9.1,"rotulo":"cérebro","fica":false},{"ini":31.87,"fim":39.45,"rotulo":"caminho com pegadas","fica":false},{"ini":46.93,"fim":54.65,"rotulo":"prancheta","fica":false},{"ini":58.54,"fim":65.3,"rotulo":"ampulheta","fica":true}]},{"id":"anim","nome":"Animações","itens":[{"ini":14.13,"fim":32.24,"rotulo":"neurônios e cordão"},{"ini":54.25,"fim":58.74,"rotulo":"barra 66, 18, 254 dias"}]},{"id":"zoom","nome":"Zoom","itens":[{"ini":8.41,"fim":9.24,"rotulo":"zoom de 30%"},{"ini":31.61,"fim":33.0,"rotulo":"zoom de 30%"},{"ini":52.25,"fim":54.2,"rotulo":"zoom de 30%"},{"ini":62.73,"fim":64.56,"rotulo":"zoom de 30%"}]},{"id":"som","nome":"Papel","itens":[{"ini":11.92,"fim":11.92,"rotulo":"papel abre"},{"ini":31.57,"fim":31.57,"rotulo":"papel fecha"},{"ini":39.05,"fim":39.05,"rotulo":"papel abre"},{"ini":46.68,"fim":46.68,"rotulo":"papel fecha"},{"ini":47.59,"fim":47.59,"rotulo":"papel abre"},{"ini":50.52,"fim":50.52,"rotulo":"papel fecha"},{"ini":52.19,"fim":52.19,"rotulo":"papel abre"},{"ini":54.2,"fim":54.2,"rotulo":"papel fecha"},{"ini":59.65,"fim":59.65,"rotulo":"papel abre"}]}],"palavras":[["De",0.0,0.3],["manhã,",0.3,0.62],["você",0.74,0.98],["escova",0.98,1.28],["os",1.28,1.48],["dentes,",1.48,1.74],["passa",1.92,2.04],["o",2.04,2.18],["café",2.18,2.